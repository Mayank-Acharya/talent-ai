# ==========================================
# Dedicated Prisma Container for Database Migrations & Prisma Studio
# ==========================================
FROM node:20-alpine

WORKDIR /app

# Install native dependencies required by Prisma engine on Alpine Linux
RUN apk add --no-cache openssl libc6-compat

# Copy package manifests and configurations
COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma/
COPY src ./src/

# Install dependencies including Prisma CLI and dev tools
RUN npm install

# Generate Prisma Client specifically for the Alpine Linux runtime
RUN npx prisma generate

# Expose Prisma Studio port
EXPOSE 5555

# On startup: sync database schema to PostgreSQL, then launch Prisma Studio Web UI
CMD ["sh", "-c", "npx prisma db push && npx prisma studio --browser none --port 5555 --hostname 0.0.0.0"]
