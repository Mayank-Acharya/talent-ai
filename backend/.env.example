# Server Configuration
PORT=5000
FRONTEND_URL="https://your-frontend-app.vercel.app"

# PostgreSQL Database (e.g. from Neon.tech, Supabase.com, or Railway)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:your_password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret (Generate a random 32+ character string)
JWT_SECRET="your_production_secure_jwt_secret_key_here_minimum_32_chars"

# AI Evaluation Keys
GEMINI_API_KEY="your_google_gemini_api_key_here"
OPENAI_API_KEY=""

# Payment Gateways
# Razorpay (for UPI & Indian Cards)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Stripe (for International USD & Global Cards)
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
